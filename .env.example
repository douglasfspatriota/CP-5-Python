# Copie este arquivo para ".env" e ajuste se precisar.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=futebol_dados

# Troque pelo e-mail do grupo (a Wikipédia pede um contato no User-Agent)
USER_AGENT=FutebolDadosCrawler/1.0 (projeto academico; contato: grupo@exemplo.com)

# Intervalo entre requisições à Wikipédia, em segundos
INTERVALO_REQUISICOES=1.0

# Temporadas padrão do crawler (ano de início).
# Deixe ANO_FIM vazio para coletar até a temporada atual (em andamento) de cada liga.
ANO_INICIO=2015
ANO_FIM=
